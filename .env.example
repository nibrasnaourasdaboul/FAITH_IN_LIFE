SECRET_KEY=change-me-to-a-long-random-string
# PostgreSQL 16 on this PC listens on port 3000.
DATABASE_URL=postgresql+asyncpg://postgres:YOUR_PASSWORD@127.0.0.1:3000/faith_in_life
REDIS_URL=redis://localhost:6379/0
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Leave SMTP blank to show the code on the verification page.
# To deliver into Gmail, use an App Password from the Google account:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASSWORD=your-16-character-app-password
# SMTP_FROM=you@gmail.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=FAITH in LIFE <noreply@faithinlife.local>
SMTP_TLS=true
STORAGE_BACKEND=local
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=faith
MINIO_SECRET_KEY=faithsecret
MINIO_SECURE=false
ADMIN_EMAIL=admin@faithinlife.local
ADMIN_PASSWORD=ChangeMe!2026
ADMIN_NAME=System Admin
SEED_ON_STARTUP=true
