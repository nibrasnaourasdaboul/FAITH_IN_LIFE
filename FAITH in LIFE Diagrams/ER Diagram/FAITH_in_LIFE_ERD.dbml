  weekly_summary_id uuid [pk]
  smart_report_id uuid [unique] 
  guardian_id uuid
  week_start date
  completed_sessions int
  performance_notes string
}

Table ReportSession {
  report_session_id uuid [pk]
  smart_report_id uuid
  session_id uuid

  indexes {
    (smart_report_id, session_id) [unique]
  }
}

Table StatisticSnapshot {
  snapshot_id uuid [pk]
  admin_id uuid
  period_start date
  period_end date
  completed_sessions int
  avg_compliance float
  alerts_count int
  export_uri string
  generated_at datetime
}

Table BackupSchedule {
  schedule_id uuid [pk]
  admin_id uuid
  cron_expr string
  retention_policy string
  is_enabled boolean
}

Table BackupJob {
  backup_id uuid [pk]
  schedule_id uuid
  admin_id uuid
  backup_type string
  scope string
  storage_uri string
  checksum string
  encryption_status string
  job_status string
  started_at datetime
  finished_at datetime
}

Table BackupIntegrityCheck {
  integrity_id uuid [pk]
  backup_id uuid
  passed boolean
  details string
  checked_at datetime
}

Table RestoreOperation {
  restore_id uuid [pk]
  backup_id uuid
  admin_id uuid
  restore_status string
  started_at datetime
  finished_at datetime
}

Table RestoreVerification {
  verification_id uuid [pk]
  restore_id uuid [unique]
  data_consistent boolean
  verification_notes string
  verified_at datetime
}

Table AuditLogEntry {
  audit_id uuid [pk]
  actor_user_id uuid
  reviewed_by_admin_id uuid
  record_id uuid
  action_type string
  entity_name string
  details string
  occurred_at datetime
}

Table AuditReviewNote {
  note_id uuid [pk]
  audit_id uuid
  admin_id uuid
  note_text string
  protection_action string
  noted_at datetime
}

Table DataAccessLog {
  access_id uuid [pk]
  user_id uuid
  record_id uuid
  access_type string
  purpose string
  accessed_at datetime
}

Table StoredFile {
  file_id uuid [pk]
  uploader_user_id uuid
  mime_type string
  storage_uri string
  checksum string
  scan_status string
  encryption_key_ref string
  uploaded_at datetime
}

